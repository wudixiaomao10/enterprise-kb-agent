OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_STORE=postgres
KNOWLEDGE_DB_PATH=.codex-tmp/knowledge.db
KNOWLEDGE_DATABASE_URL=postgresql://knowledge:knowledge@127.0.0.1:5432/knowledge
KNOWLEDGE_AUTO_MIGRATE=1
KNOWLEDGE_DB_POOL_MIN_SIZE=1
KNOWLEDGE_DB_POOL_MAX_SIZE=10
KNOWLEDGE_DB_POOL_MAX_WAITING=50
KNOWLEDGE_DB_POOL_TIMEOUT_SECONDS=30
KNOWLEDGE_DB_POOL_WAIT_SECONDS=30
KNOWLEDGE_JOB_MAX_ATTEMPTS=4
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=30
KNOWLEDGE_EMBEDDING_MAX_RETRIES=3
KNOWLEDGE_LLM_PROVIDER=openai
KNOWLEDGE_LLM_MODEL=gpt-4.1-mini
KNOWLEDGE_LLM_JSON_MODE=json_schema
KNOWLEDGE_RERANKER_PROVIDER=llm
KNOWLEDGE_RERANKER_MIN_SCORE=0.20
KNOWLEDGE_VERIFIER_MIN_SUPPORT=0.25
KNOWLEDGE_VERIFIER_MIN_COVERAGE=1.0
# OpenTelemetry is optional for offline development and enabled in production.
KNOWLEDGE_OTEL_ENABLED=0
KNOWLEDGE_OTEL_SERVICE_NAME=enterprise-kb-agent
KNOWLEDGE_OTEL_SERVICE_VERSION=0.1.0
KNOWLEDGE_OTEL_EXPORTER=none
KNOWLEDGE_OTEL_ENDPOINT=
KNOWLEDGE_OTEL_SAMPLE_RATIO=1.0
KNOWLEDGE_OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# Values are USD per 1,000 tokens. A model-specific JSON map can override these.
KNOWLEDGE_LLM_INPUT_COST_PER_1K_USD=0
KNOWLEDGE_LLM_OUTPUT_COST_PER_1K_USD=0
KNOWLEDGE_EMBEDDING_INPUT_COST_PER_1K_USD=0
KNOWLEDGE_MODEL_PRICING_JSON=
KNOWLEDGE_PDF_PARSER=docling
KNOWLEDGE_PDF_OCR=1
KNOWLEDGE_PDF_OCR_ENGINE=rapidocr
KNOWLEDGE_PDF_TABLE_STRUCTURE=1
KNOWLEDGE_PDF_ALLOW_PYPDF_FALLBACK=0
KNOWLEDGE_PDF_MAX_PAGES=500
KNOWLEDGE_UPLOAD_MAX_BYTES=104857600
KNOWLEDGE_UPLOAD_MAX_ARCHIVE_BYTES=209715200
KNOWLEDGE_UPLOAD_MAX_ARCHIVE_ENTRIES=1000
KNOWLEDGE_UPLOAD_MAX_COMPRESSION_RATIO=200
KNOWLEDGE_VIRUS_SCANNER_COMMAND=
KNOWLEDGE_VIRUS_SCAN_REQUIRED=0
KNOWLEDGE_VIRUS_SCAN_TIMEOUT_SECONDS=30
KNOWLEDGE_QUARANTINE_DIR=.codex-tmp/quarantine
KNOWLEDGE_MODEL_CACHE_DIR=.codex-tmp/model-cache
KNOWLEDGE_OBJECT_STORAGE=minio
KNOWLEDGE_S3_ENDPOINT=http://127.0.0.1:9000
KNOWLEDGE_S3_REGION=us-east-1
KNOWLEDGE_S3_BUCKET=enterprise-knowledge
KNOWLEDGE_S3_ACCESS_KEY=knowledge_minio
KNOWLEDGE_S3_SECRET_KEY=replace-with-a-long-random-secret
KNOWLEDGE_S3_PREFIX=documents
KNOWLEDGE_S3_AUTO_CREATE_BUCKET=1
KNOWLEDGE_S3_FORCE_PATH_STYLE=1
KNOWLEDGE_MATERIALIZE_DIR=.codex-tmp/materialized-documents
KNOWLEDGE_JOB_MODE=dramatiq
KNOWLEDGE_REDIS_URL=redis://127.0.0.1:6380/0
KNOWLEDGE_RESEARCH_MIN_EVIDENCE_SCORE=0.08
KNOWLEDGE_RESEARCH_TARGET_COVERAGE=1.0
KNOWLEDGE_RESEARCH_MAX_EVIDENCE=24
KNOWLEDGE_RESEARCH_CHECKPOINTS=1
KNOWLEDGE_RESEARCH_CHECKPOINT_SETUP=1
KNOWLEDGE_RESEARCH_CHECKPOINT_DELETE_ON_TERMINAL=1
# Optional: set a base64 or raw AES key accepted by LangGraph EncryptedSerializer
KNOWLEDGE_RESEARCH_CHECKPOINT_ENCRYPTION_KEY=
KNOWLEDGE_AUTH_MODE=local
KNOWLEDGE_IDENTITY_MODE=directory
KNOWLEDGE_AUTH_ALLOW_DEV_TOKEN=1
KNOWLEDGE_JWT_SECRET=replace-with-at-least-32-random-characters
KNOWLEDGE_JWT_ISSUER=enterprise-kb-agent
KNOWLEDGE_JWT_AUDIENCE=knowledge-api

# Production OIDC/SSO alternative (replace the local auth settings above)
# KNOWLEDGE_AUTH_MODE=oidc
# KNOWLEDGE_AUTH_ALLOW_DEV_TOKEN=0
# KNOWLEDGE_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# KNOWLEDGE_OIDC_AUDIENCE=knowledge-api-client-id
# KNOWLEDGE_OIDC_JWKS_URL=https://login.example.com/tenant/discovery/v2.0/keys
# KNOWLEDGE_OIDC_CLIENT_ID=single-page-application-client-id
# KNOWLEDGE_OIDC_SCOPE=api://knowledge-api-client-id/access_as_user
# KNOWLEDGE_OIDC_REQUIRED_SCOPE=access_as_user
# KNOWLEDGE_OIDC_TRUSTED_ADMIN_APP_ROLE=Knowledge.Admin
# KNOWLEDGE_OIDC_REDIRECT_URI=http://localhost:8010/
# KNOWLEDGE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8010/
# KNOWLEDGE_OIDC_TOKEN_REFRESH_SKEW_SECONDS=120
# KNOWLEDGE_OIDC_ALGORITHMS=RS256
# KNOWLEDGE_OIDC_SUBJECT_CLAIM=oid
# KNOWLEDGE_OIDC_DEPARTMENT_CLAIM=department_ids
# KNOWLEDGE_OIDC_ROLE_CLAIM=role_ids

# Microsoft Entra ID directory synchronization through Microsoft Graph delta
KNOWLEDGE_GRAPH_ENABLED=0
KNOWLEDGE_GRAPH_TENANT_ID=your-tenant-id
KNOWLEDGE_GRAPH_CLIENT_ID=your-app-client-id
KNOWLEDGE_GRAPH_CLIENT_SECRET=replace-with-client-secret
KNOWLEDGE_GRAPH_SOURCE=microsoft-graph
KNOWLEDGE_GRAPH_OIDC_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
KNOWLEDGE_GRAPH_WEBHOOK_URL=https://kb.example.com/webhooks/microsoft-graph
KNOWLEDGE_GRAPH_LIFECYCLE_WEBHOOK_URL=https://kb.example.com/webhooks/microsoft-graph-lifecycle
KNOWLEDGE_GRAPH_CLIENT_STATE=replace-with-at-least-16-random-characters
KNOWLEDGE_GRAPH_GROUP_ID_MAP={"entra-group-object-id":"sales"}
KNOWLEDGE_GRAPH_ADMIN_GROUP_IDS=entra-admin-group-object-id
KNOWLEDGE_GRAPH_SUBSCRIPTION_MINUTES=1440
KNOWLEDGE_GRAPH_SUBSCRIPTION_RENEW_BEFORE_MINUTES=180

# Feishu Contact v3 directory synchronization and encrypted event webhook
KNOWLEDGE_FEISHU_ENABLED=0
KNOWLEDGE_FEISHU_APP_ID=cli_replace_me
KNOWLEDGE_FEISHU_APP_SECRET=replace-with-app-secret
KNOWLEDGE_FEISHU_SOURCE=feishu-contact
KNOWLEDGE_FEISHU_ISSUER=feishu:cli_replace_me
KNOWLEDGE_FEISHU_BASE_URL=https://open.feishu.cn
KNOWLEDGE_FEISHU_ROOT_DEPARTMENT_ID=0
KNOWLEDGE_FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
KNOWLEDGE_FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
KNOWLEDGE_FEISHU_DEPARTMENT_ID_MAP={"feishu-open-department-id":"sales"}
KNOWLEDGE_FEISHU_ADMIN_USER_IDS=feishu-admin-open-id
KNOWLEDGE_FEISHU_WEBHOOK_MAX_AGE_SECONDS=300

# SCIM 2.0 provisioning endpoint: /scim/v2
KNOWLEDGE_SCIM_ENABLED=0
KNOWLEDGE_SCIM_TOKEN=replace-with-at-least-32-random-characters
KNOWLEDGE_SCIM_SOURCE=enterprise-scim
KNOWLEDGE_SCIM_OIDC_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
KNOWLEDGE_SCIM_GROUP_ID_MAP={"idp-group-id":"sales"}
KNOWLEDGE_SCIM_ADMIN_GROUP_IDS=idp-admin-group-id

# Azure OpenAI alternative
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_LLM_DEPLOYMENT=
